!*.avif

# 3. 虚拟环境必须放在白名单之后，
#    否则 !*.py 会把 .venv 内的 .py 文件重新纳入。
.venv/
.venv*/
venv/
ENV/
env/
pwn_env/
auto_env/

# 4. Python 缓存与测试产物。
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.eggs/
*.egg-info/
build/
dist/
wheels/

